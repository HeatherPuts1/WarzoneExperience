# Unity auto-generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/MemoryCaptures/

# Asset Store tools (optional)
Assets/AssetStoreTools*

# User settings / cache
/[Uu]ser[Ss]ettings/
/sysinfo.txt

# Keep project settings and meta files
!/[Pp]roject[Ss]ettings/**/*.asset
!/[Aa]ssets/**/*.meta

# Ignore large assets you don't want in Git (optional)
Assets/StreamingAssets/*
Assets/Plugins/Oculus/*

# Visual Studio / IDE files
/.vs/
/.vscode/
/.idea/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb

# Builds / export
*.apk
*.aab
*.unitypackage
