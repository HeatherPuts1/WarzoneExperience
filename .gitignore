# =============== #
# Unity .gitignore
# =============== #

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Visual Studio / JetBrains
.vs/
.idea/
*.user
*.userprefs
*.suo
*.tmp
*.userosscache
*.sln.docstates
*.iml

# Build results
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Dd]ebug/
[Rr]elease/
[Tt]emp/
[Bb]in/
[Oo]bj/

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/
sysinfo.txt

# Asset Store tools
Assets/AssetStoreTools*

# Autogenerated VS/MD/Consulo solution and project files
*.csproj
*.unityproj
*.sln
*.sln.*
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# Unity cache
/.gradle/
.gradle/
.gradle-cache/
*.apk
*.aab

# Crash Reports
*.stacktrace

# VR Specific (Oculus/Meta/SteamVR generated files)
Oculus/Tools/
Oculus/SDK/Plugins/Android/libs/
Oculus/SDK/Plugins/Win64/
SteamVR/Tools/
SteamVR/Resources/*_autogenerated.cs

# Rider
.idea/
*.iml

# Exclude auto-generated packages
*.unitypackage

# Local settings
*.swp
*.lock

# Addressables
/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.hash
/[Aa]ddressable[Aa]ssets[Dd]ata/*/catalog.json

# Lighting
[Ll]ibrary/LightingData.asset
[Ll]ibrary/LightmapSnapshot

# ================== #
# Project-specific
# ================== #

# Ignore Unity Samples (can be reimported anytime)
Assets/Samples/

# Ignore demo/sample scenes
Assets/**/DemoScene*.unity
Assets/**/DemoSceneAssets.meta

# Ignore generated package tools
Assets/AssetStoreTools*

